{
  "name": "ruet-chottor",
  "version": "0.0.0",
  "private": true,
  "description": "RUET Chottor - an open-source campus platform for RUET students",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @ruet-chottor/shared build && pnpm --parallel --filter \"./apps/*\" --filter @ruet-chottor/shared dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @ruet-chottor/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @ruet-chottor/shared build && pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.4.0",
    "typescript-eslint": "^8.46.0"
  }
}
