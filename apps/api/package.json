{
  "name": "api",
  "version": "0.0.1",
  "description": "RUET Chottor REST + real-time API (NestJS)",
  "author": "RUET Chottor contributors",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main",
    "start:debug": "nest start --debug --watch",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint src test prisma",
    "test": "prisma generate && vitest run && vitest run --config ./vitest.config.e2e.ts",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "prisma": "prisma",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.3.2",
    "@nestjs/websockets": "^12.3.2",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@ruet-chottor/shared": "workspace:*",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "nodemailer": "^10.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "prisma": "^7.0.0",
    "socket.io-client": "^4.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
