# Copy to `.env` in this folder and fill in. Never commit `.env`.
# See docs/getting-started.md for how to get free Neon and Upstash URLs.

NODE_ENV=development
PORT=4000

# Origin of the web app, used for CORS and cookies.
WEB_ORIGIN=http://localhost:3000

# PostgreSQL (Neon). Use the *pooled* connection string here, with `sslmode=verify-full`...
DATABASE_URL=
# ...and the *direct* (non-pooled) one here; Prisma migrations use it.
DIRECT_URL=

# Redis (Upstash). Use the `rediss://` TCP URL, not the REST URL.
REDIS_URL=

# 32+ random characters. Signs one-time login codes. Optional in development (a random one is
# used per run), required in production. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=

# Outgoing email, e.g. smtps://user:pass@smtp.example.com:465. Optional in development: without it,
# mail goes to a throwaway Ethereal inbox and the API logs a preview link (ADR 0004).
SMTP_URL=
MAIL_FROM='"RUET Chottor" <no-reply@example.com>'

# Chat spam protection: messages one member may send per minute (default 30).
CHAT_SEND_LIMIT_PER_MINUTE=30

# Feature flags: a module is on only when its flag is exactly `true` (CLAUDE.md §4).
# FEATURE_AUTH=true
# FEATURE_USERS=true  # profiles; needs FEATURE_AUTH
# FEATURE_DIRECTORY=true  # member search; needs FEATURE_AUTH and FEATURE_USERS
# FEATURE_CHAT=true  # 1:1 and group messages over Socket.IO; needs FEATURE_AUTH
# FEATURE_NEWS=true
# FEATURE_CLUBS=true
# FEATURE_EVENTS=true
# FEATURE_LOST_FOUND=true
# FEATURE_MARKETPLACE=true
# FEATURE_BUS=true
# FEATURE_MODERATION=true
# FEATURE_ADMIN=true  # admin panel for moderators and admins; needs FEATURE_AUTH
# FEATURE_NOTIFICATIONS=true
