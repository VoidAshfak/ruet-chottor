# Copy to `.env` in this folder and fill in. Never commit `.env`.
# See docs/getting-started.md for how to get free Neon and Upstash URLs.

NODE_ENV=development
PORT=4000

# Origin of the web app, used for CORS and cookies.
WEB_ORIGIN=http://localhost:3000

# PostgreSQL (Neon). Use the *pooled* connection string here...
DATABASE_URL=
# ...and the *direct* (non-pooled) one here; Prisma migrations use it.
DIRECT_URL=

# Redis (Upstash). Use the `rediss://` TCP URL, not the REST URL.
REDIS_URL=

# Feature flags: a module is on only when its flag is exactly `true` (CLAUDE.md §4).
# FEATURE_AUTH=true
# FEATURE_USERS=true
# FEATURE_DIRECTORY=true
# FEATURE_CHAT=true
# FEATURE_NEWS=true
# FEATURE_CLUBS=true
# FEATURE_EVENTS=true
# FEATURE_LOST_FOUND=true
# FEATURE_MARKETPLACE=true
# FEATURE_BUS=true
# FEATURE_MODERATION=true
# FEATURE_ADMIN=true
# FEATURE_NOTIFICATIONS=true
