// RUET Chottor database schema.
// Each module keeps its models under a `// ===== <module> =====` heading (CLAUDE.md §4).
// The connection URL lives in prisma.config.ts, not here (Prisma 7).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ===== media (core) =====
// Files stored in Cloudinary (ADR 0010). Shared infrastructure in core/media, used by content modules.
// The browser uploads directly; a row starts `pending` and becomes `ready` once the API checked the file.

enum MediaKind {
  image
  video
  document
}

enum MediaStatus {
  pending
  ready
}

model MediaAsset {
  id         String      @id @default(uuid(7)) @db.Uuid
  ownerId    String      @db.Uuid
  kind       MediaKind
  /// Where it will be attached, e.g. "news.post" (MEDIA_PURPOSES in packages/shared).
  purpose    String
  /// Cloudinary public id, e.g. "ruet-chottor/dev/news-post/<id>".
  publicId   String      @unique
  status     MediaStatus @default(pending)
  format     String?
  bytes      Int?
  width      Int?
  height     Int?
  /// The content item it belongs to; null until attached.
  contentId  String?     @db.Uuid
  /// Order within the content item.
  position   Int         @default(0)
  createdAt  DateTime    @default(now())
  attachedAt DateTime?

  @@index([ownerId, status])
  @@index([purpose, contentId])
  @@map("media_assets")
}

// ===== auth =====
// Identity and login. Profile fields and directory privacy settings belong to the `users` module.

enum Role {
  student
  alumni
  teacher
  club_manager
  moderator
  admin
}

enum AccountStatus {
  active
  suspended
  banned
}

model User {
  id             String               @id @default(uuid(7)) @db.Uuid
  name           String
  roll           String               @unique
  registrationNo String               @unique
  /// Stored lowercase.
  email          String               @unique
  /// Normalised to +8801XXXXXXXXX.
  phone          String               @unique
  dateOfBirth    DateTime             @db.Date
  /// argon2id; never returned by the API.
  passwordHash   String
  role           Role                 @default(student)
  status         AccountStatus        @default(active)
  /// End of a temporary suspension; lifted at the next login after this time.
  suspendedUntil DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  sessions       Session[]
  profile        Profile?
  conversations  ConversationMember[]
  clubs          ClubMembership[]

  @@map("users")
}

/// One per logged-in device. The refresh token rotates on every use; only hashes are stored.
model Session {
  id                       String    @id @default(uuid(7)) @db.Uuid
  userId                   String    @db.Uuid
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash         String    @unique
  /// The token this one replaced. Seeing it again means it was stolen: the session is revoked.
  previousRefreshTokenHash String?   @unique
  userAgent                String?
  expiresAt                DateTime
  revokedAt                DateTime?
  createdAt                DateTime  @default(now())
  lastUsedAt               DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

// ===== users =====
// Profile settings. Department and series are not stored: they come from the roll
// (packages/shared/src/users/departments.ts), so fixing that table fixes every profile.

/// Created the first time a user changes a setting; missing means "all defaults".
model Profile {
  userId          String   @id @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Directory privacy (CLAUDE.md §6): hidden unless the user opts in.
  showEmail       Boolean  @default(false)
  showPhone       Boolean  @default(false)
  /// Keys of first-visit guides the user closed, e.g. "home", "lost-found".
  dismissedGuides String[] @default([])
  updatedAt       DateTime @updatedAt

  @@map("profiles")
}

// ===== admin =====
// The moderation audit trail. Owned by admin and written through ModerationLogService, which
// later modules (moderation reports, news, chat...) use too. Field names follow the
// add-moderation skill so content moderation can reuse it as is (ADR 0007).

enum ModerationAction {
  warn_user
  suspend_user
  ban_user
  reinstate_user
  change_role
  hide_content
  remove_content
  restore_content
  dismiss_reports
  approve_content
  reject_content
}

/// Append-only: a database trigger rejects UPDATE and DELETE (see the add_admin migration).
model ModerationLog {
  id           String           @id @default(uuid(7)) @db.Uuid
  /// Who acted. Kept as a plain id so the log survives account deletion.
  moderatorId  String           @db.Uuid
  action       ModerationAction
  targetUserId String?          @db.Uuid
  /// For content actions later, e.g. "marketplace.listing".
  contentType  String?
  contentId    String?
  reason       String
  /// Action specifics, e.g. { "days": 7 } or { "from": "student", "to": "moderator" }.
  details      Json?
  createdAt    DateTime         @default(now())

  @@index([targetUserId, createdAt])
  @@index([createdAt])
  @@map("moderation_logs")
}

// ===== chat =====
// 1:1 and group conversations. Messages are saved here first, then pushed over Socket.IO
// (CLAUDE.md §10): the socket is a delivery channel, Postgres is the source of truth.

/// Visibility of user-generated content (CLAUDE.md §7). Other content modules reuse it.
enum ContentStatus {
  visible
  hidden
  removed
}

enum ConversationType {
  direct
  group
}

enum ConversationRole {
  owner
  member
}

model Conversation {
  id            String               @id @default(uuid(7)) @db.Uuid
  type          ConversationType
  /// Group name; null for 1:1 chats.
  name          String?
  createdById   String               @db.Uuid
  /// "<smaller user id>:<larger user id>" for 1:1 chats, so two people share one chat.
  directKey     String?              @unique
  /// Bumped on every message; sorts the conversation list.
  lastMessageAt DateTime             @default(now())
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  members       ConversationMember[]
  messages      Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationMember {
  conversationId String           @db.Uuid
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String           @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           ConversationRole @default(member)
  /// Messages after this are unread for the member.
  lastReadAt     DateTime         @default(now())
  joinedAt       DateTime         @default(now())
  /// Set when the member left or was removed; they keep no access.
  leftAt         DateTime?

  @@id([conversationId, userId])
  @@index([userId, leftAt])
  @@map("conversation_members")
}

model Message {
  id             String        @id @default(uuid(7)) @db.Uuid
  conversationId String        @db.Uuid
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Plain id (no relation) so messages survive account deletion, like the moderation log.
  senderId       String        @db.Uuid
  /// Kept after deletion so moderators can still review reports; never served once deleted.
  body           String
  status         ContentStatus @default(visible)
  /// Set when the sender deleted the message.
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ===== moderation =====
// Reports on user-generated content (CLAUDE.md §7). Content modules register their content type
// in core/moderation (ModeratableContentRegistry); this module never imports their internals.

enum ReportReason {
  spam
  harassment
  violence
  misinformation
  inappropriate
  scam
  other
}

enum ReportStatus {
  open
  /// A moderator hid or removed the item.
  actioned
  dismissed
}

model Report {
  id           String       @id @default(uuid(7)) @db.Uuid
  /// e.g. "chat.message" (MODERATABLE_CONTENT_TYPES in packages/shared).
  contentType  String
  contentId    String       @db.Uuid
  /// Never shown to the author; staff see it to follow up false reports.
  reporterId   String       @db.Uuid
  reason       ReportReason
  note         String?
  status       ReportStatus @default(open)
  resolvedById String?      @db.Uuid
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())

  /// One report per person per item.
  @@unique([contentType, contentId, reporterId])
  @@index([status, contentType])
  @@map("reports")
}

// ===== news =====
// Campus news. Posts by verified roles (moderator, admin, club_manager) publish at once; others wait
// for a moderator (CLAUDE.md §7). Photos and videos are MediaAssets with purpose "news.post".

enum NewsCategory {
  announcement
  academic
  event
  club
  general
}

enum NewsReview {
  pending
  approved
  rejected
}

model NewsPost {
  id           String        @id @default(uuid(7)) @db.Uuid
  title        String
  category     NewsCategory
  body         String
  /// Plain id (no relation) so posts survive account deletion.
  createdById  String        @db.Uuid
  review       NewsReview    @default(pending)
  /// Reason given by the moderator (shown to the author on rejection).
  reviewNote   String?
  reviewedById String?       @db.Uuid
  reviewedAt   DateTime?
  /// Moderation after reports (moderation module): hidden/removed posts leave the feed.
  status       ContentStatus @default(visible)
  /// Set on first approval; sorts the feed.
  publishedAt  DateTime?
  /// Posted for this club (clubs module); only its managers may. Plain id, no relation.
  clubId       String?       @db.Uuid
  /// Deleted by its author.
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([review, status, publishedAt])
  @@index([createdById, createdAt])
  @@index([clubId, publishedAt])
  @@map("news_posts")
}

// ===== clubs =====
// Campus clubs. Admins create clubs and appoint managers; members ask to join and a manager approves.
// Logos and covers are MediaAssets with purposes "clubs.logo" and "clubs.cover".

enum ClubCategory {
  technical
  cultural
  sports
  social_service
  academic
  other
}

enum ClubRole {
  manager
  member
}

enum MembershipState {
  pending
  active
}

model Club {
  id           String           @id @default(uuid(7)) @db.Uuid
  name         String           @unique
  /// From the name; the club page is /clubs/<slug>.
  slug         String           @unique
  tagline      String
  category     ClubCategory
  about        String           @default("")
  /// The club's public contact, not a member's personal address.
  contactEmail String?
  /// [{ label, url }], at most 3.
  links        Json             @default("[]")
  createdById  String           @db.Uuid
  /// Moderation after reports: hidden/removed clubs leave the list.
  status       ContentStatus    @default(visible)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  memberships  ClubMembership[]

  @@index([status, name])
  @@map("clubs")
}

model ClubMembership {
  clubId      String          @db.Uuid
  club        Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId      String          @db.Uuid
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        ClubRole        @default(member)
  state       MembershipState @default(pending)
  requestedAt DateTime        @default(now())
  joinedAt    DateTime?

  @@id([clubId, userId])
  @@index([userId])
  @@index([clubId, state])
  @@map("club_memberships")
}

// ===== events =====
// Campus events, organised by club managers (for their club) and staff (campus-wide or for a club).
// Posters are MediaAssets with purpose "events.poster".

enum EventCategory {
  workshop
  competition
  seminar
  cultural
  sports
  meeting
  other
}

model Event {
  id          String        @id @default(uuid(7)) @db.Uuid
  title       String
  category    EventCategory
  description String        @default("")
  venue       String
  startsAt    DateTime
  endsAt      DateTime
  /// The organising club (clubs module); null for campus-wide events. Plain id, no relation.
  clubId      String?       @db.Uuid
  /// Most people who can say "Going"; null for no limit.
  capacity    Int?
  createdById String        @db.Uuid
  /// Moderation after reports: hidden/removed events leave the calendar.
  status      ContentStatus @default(visible)
  /// Cancelled events stay on the calendar, marked, so people are not left guessing.
  cancelledAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  rsvps       EventRsvp[]

  @@index([status, startsAt])
  @@index([clubId, startsAt])
  @@map("events")
}

model EventRsvp {
  eventId   String   @db.Uuid
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  @@id([eventId, userId])
  @@index([userId])
  @@map("event_rsvps")
}

// ===== lost-found =====
// Lost and found items on campus. Photos are MediaAssets with purpose "lost-found.item".
// Open posts leave the board 30 days after posting (expiresAt); reopening adds another 30 days.

enum LostFoundKind {
  lost
  found
}

enum LostFoundCategory {
  id_card
  phone
  keys
  wallet
  bag
  book
  electronics
  clothing
  other
}

enum CampusPlace {
  central_library
  academic_building
  cafeteria
  central_auditorium
  residential_hall
  medical_centre
  playground
  bus
  main_gate
  other
}

enum LostFoundState {
  open
  returned
  closed
}

model LostFoundItem {
  id             String            @id @default(uuid(7)) @db.Uuid
  kind           LostFoundKind
  category       LostFoundCategory
  title          String
  description    String            @default("")
  place          CampusPlace
  placeDetail    String?
  /// The day it was lost or found (Dhaka).
  happenedOn     DateTime          @db.Date
  /// Found items: asked to claimants in chat; the answer is never stored.
  verifyQuestion String?
  createdById    String            @db.Uuid
  state          LostFoundState    @default(open)
  /// No scheduler: the board simply leaves out open posts past this time.
  expiresAt      DateTime
  status         ContentStatus     @default(visible)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, state, expiresAt, createdAt])
  @@index([createdById, createdAt])
  @@map("lost_found_items")
}

// ===== marketplace =====
// Buying and selling between members; payment happens in person. Photos are MediaAssets with purpose
// "marketplace.listing". Listings mentioning a held term start hidden and go to the moderation queue.
// Meeting places reuse CampusPlace (lost-found section).

enum ListingCategory {
  books
  electronics
  lab_equipment
  furniture
  clothing
  bicycles
  tickets
  other
}

enum ListingCondition {
  new
  like_new
  good
  fair
}

enum ListingState {
  available
  reserved
  sold
}

model Listing {
  id          String           @id @default(uuid(7)) @db.Uuid
  title       String
  category    ListingCategory
  condition   ListingCondition
  /// Whole taka; 0 means free.
  priceTaka   Int
  description String           @default("")
  meetPlace   CampusPlace
  meetDetail  String?
  createdById String           @db.Uuid
  state       ListingState     @default(available)
  /// No scheduler: browsing leaves out listings past this time; the seller can renew.
  expiresAt   DateTime
  status      ContentStatus    @default(visible)
  /// The held term that sent it to moderators, shown to the seller.
  heldTerm    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, state, expiresAt, createdAt])
  @@index([status, state, expiresAt, priceTaka])
  @@index([createdById, createdAt])
  @@map("listings")
}

// ===== bus =====
// The campus bus timetable, edited by admins. Each stop records its travel time from campus, so a
// trip's time at any stop is its departure plus that offset (live tracking comes later).

enum BusDirection {
  from_campus
  to_campus
}

enum BusColor {
  blue
  orange
  green
  red
  purple
  teal
}

model BusRoute {
  id          String      @id @default(uuid(7)) @db.Uuid
  name        String      @unique
  description String      @default("")
  color       BusColor
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  stops       BusStop[]
  trips       BusTrip[]
  notices     BusNotice[]

  @@map("bus_routes")
}

model BusStop {
  id                String   @id @default(uuid(7)) @db.Uuid
  routeId           String   @db.Uuid
  route             BusRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  name              String
  /// Order along the route, campus first.
  position          Int
  minutesFromCampus Int

  @@index([routeId, position])
  @@map("bus_stops")
}

model BusTrip {
  id            String       @id @default(uuid(7)) @db.Uuid
  routeId       String       @db.Uuid
  route         BusRoute     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  direction     BusDirection
  /// Minutes after midnight (Dhaka) when it leaves its first stop.
  departMinutes Int
  /// JavaScript weekdays: 0 = Sunday ... 6 = Saturday.
  days          Int[]
  note          String?

  @@index([routeId])
  @@map("bus_trips")
}

model BusNotice {
  id          String    @id @default(uuid(7)) @db.Uuid
  /// null for all routes.
  routeId     String?   @db.Uuid
  route       BusRoute? @relation(fields: [routeId], references: [id], onDelete: Cascade)
  message     String
  startsOn    DateTime  @db.Date
  endsOn      DateTime  @db.Date
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())

  @@index([endsOn])
  @@map("bus_notices")
}

// ===== notifications =====
// One row per recipient, written by the system when something happens to a member's content or
// clubs (docs/modules/notifications.md). Not user-generated, so there is nothing to moderate.

model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  /// `<module>.<event>`, one of NOTIFICATION_TYPES in packages/shared.
  type      String
  title     String
  body      String?
  /// A path inside the web app.
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}
